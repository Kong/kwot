# ============================================================================
# KWOT ENVIRONMENT CONFIGURATION EXAMPLE
# ============================================================================
# Copy this file to .env and configure for your environment
# Use: cp .env.example .env && source .env
# ============================================================================

# ============================================================================
# REQUIRED: Kong Connection Settings
# ============================================================================

# Kong Admin API URL
# Example: http://localhost:8001 or https://kong.example.com:8001
KONG_ADDR=http://localhost:8001

# Authentication method: RBAC | PASSWORD
# - RBAC: Use ADMIN_TOKEN for token-based auth (recommended)
# - PASSWORD: Use ADMIN_USER + BASE64_UID_PWD for username/password
AUTH_METHOD=RBAC

# ============================================================================
# AUTHENTICATION: RBAC Method (recommended)
# ============================================================================
# Use these when AUTH_METHOD=RBAC

# Admin API token for authentication
# Generate from Kong Admin API or Kong Manager
ADMIN_TOKEN=your-admin-token-here

# ============================================================================
# AUTHENTICATION: PASSWORD Method (alternative)
# ============================================================================
# Use these when AUTH_METHOD=PASSWORD
# Leave empty if using RBAC

# Admin username
# ADMIN_USER=kong_admin

# Base64-encoded username:password
# To generate: echo -n "username:password" | base64
# Example: echo -n "kong_admin:password123" | base64 → a29uZ19hZG1pbjpwYXNzd29yZDEyMw==
# BASE64_UID_PWD=a29uZ19hZG1pbjpwYXNzd29yZDEyMw==

# ============================================================================
# OPTIONAL: SSL/TLS Configuration
# ============================================================================

# Path to CA certificate file for SSL verification
# Example: /etc/ssl/certs/ca-bundle.crt
# CA=

# Verify SSL certificates (true/false)
# Set to false only for development/testing with self-signed certificates
SSL_VERIFY=true

# HTTP proxy URL (if required)
# Specify proxy for Kong Admin API connections
# Format: http://[user:password@]host:port
# Examples:
#   http://proxy.company.com:8080
#   http://user:pass@proxy.company.com:3128
#   https://secure-proxy.company.com:8443
# PROXY=

# ============================================================================
# OPTIONAL: Configuration
# ============================================================================

# Directory containing workspace configuration files
# Default: ./config/ (relative to current directory)
CONFIG_DIR=./config/

# ============================================================================
# FEATURE FLAGS: User Management
# ============================================================================

# Automatically create RBAC users defined in config files
# true (default): Create users during apply
# false: Read-only mode, do not create users
FEATURE_CREATE_RBAC_USERS=true

# Automatically delete RBAC users during reconciliation
# true (default): Remove RBAC users not in config
# false: Preserve all existing RBAC users
FEATURE_DELETE_EXISTING_RBAC_USERS=true

# Automatically delete workspace users during reconciliation
# true: Remove workspace users not in config (aggressive)
# false (default): Preserve all workspace users
FEATURE_DELETE_EXISTING_USERS=false

# ============================================================================
# FEATURE FLAGS: Role & Workspace Management
# ============================================================================

# Automatically delete roles during reconciliation
# true (default): Remove roles not in config (recommended)
# false: Preserve all existing roles
FEATURE_DELETE_EXISTING_ROLES=true

# Force wipe workspace configuration (use with EXTREME caution!)
# true: Aggressively clean workspace (destructive)
# false (default): Safe mode, preserve existing config
FEATURE_FORCE_WIPE_WORKSPACE=false

# Enable bulk delete all command
# true: Allow 'kwot delete all --force' to delete everything
# false (default): Disable bulk delete to prevent accidents
# WARNING: When enabled, bulk delete can wipe all configurations with 5s countdown
FEATURE_DELETE_ALL_ENABLED=false

# ============================================================================
# PERFORMANCE: Concurrency & Pagination
# ============================================================================

# Number of workspaces to process in parallel
# Default: 5 (safe, recommended for small deployments)
# Range: 1-100 (max by validator)
# Recommendations by scale:
#   - Small (10-50 workspaces): 5
#   - Medium (100-500 workspaces): 15
#   - Large (500-1000 workspaces): 20
#   - Very Large (1000+ workspaces): 50 (requires testing)
# Higher values = faster but more Kong API load
MAX_CONCURRENT_WORKSPACES=5

# ============================================================================
# PAGINATION (Automatic)
# ============================================================================
# NOTE: Pagination is now handled automatically by kwot for all API calls.
# kwot uses Kong Admin API's offset-based pagination to fetch complete datasets.
# Each API call fetches up to 1000 items and automatically iterates through pages.
# This applies to: groups, workspaces, roles, users, and plugins.

# ============================================================================
# COMMAND-LINE FLAGS REFERENCE
# ============================================================================
# These are NOT environment variables but CLI flags used with kwot commands:
#
# APPLY COMMANDS
# kwot apply                      # Apply all changes (workspaces → roles → groups)
# kwot apply --workspace <name>   # Target specific workspace
# kwot apply --dry-run            # Preview changes without applying
# kwot apply --verbose            # Enable detailed logging
# kwot apply --quiet              # Suppress non-essential output
#
# DIFF COMMANDS (Read-only - shows drift)
# kwot diff                        # Show all drifts (missing + orphaned)
# kwot diff workspaces            # Show workspace drift only
# kwot diff roles                 # Show role drift only
# kwot diff groups                # Show group drift only
#
# DELETE COMMANDS (Requires --force flag)
# kwot delete --force             # Delete all resources (defaults to all with 5s countdown)
# kwot delete all --force         # Delete all resources (requires FEATURE_DELETE_ALL_ENABLED=true)
# kwot delete workspaces -n <ws> --force  # Delete specific workspace
# kwot delete roles -n <role> --force     # Delete role from all workspaces
# kwot delete roles -n <role> -w <ws> --force  # Delete role from specific workspace
# kwot delete groups -n <group> --force   # Delete specific group
# kwot delete groups --force      # Delete all groups
#
# FLAGS (Global, work with all commands)
# --dry-run            # Preview changes without applying them
# --verbose (-v)       # Enable detailed logging
# --quiet (-q)         # Suppress non-essential output
# --workspace (-w)     # Target specific workspace (where applicable)
# --config             # Specify config file path (default: .env)
#
# ============================================================================
# EXAMPLE CONFIGURATIONS BY AUTHENTICATION METHOD
# ============================================================================
#
# EXAMPLE 1: RBAC Authentication (Recommended - Token-based)
# ========================================================
# Best for: Enterprise Kong with RBAC enabled
#
# ADMIN_TOKEN=your-rbac-token-here
# CONFIG_DIR=./config/
# KONG_ADDR=http://localhost:8001
# AUTH_METHOD=RBAC
#
# FEATURE_DELETE_EXISTING_USERS=false
# FEATURE_DELETE_EXISTING_ROLES=true
# FEATURE_DELETE_EXISTING_RBAC_USERS=true
# FEATURE_CREATE_RBAC_USERS=true
#
#
# EXAMPLE 2: PASSWORD Authentication (Username + Password)
# =========================================================
# Best for: Kong Admin accounts with basic auth
# Generated with: echo -n "username:password" | base64
#
# ADMIN_USER=kong_admin
# BASE64_UID_PWD=a29uZ19hZG1pbjpwYXNzd29yZDEyMw==
# CONFIG_DIR=./config/
# KONG_ADDR=https://api.kong.lan:8444
# AUTH_METHOD=PASSWORD
# SSL_VERIFY=true
# CA=/etc/ssl/certs/ca-bundle.crt
#
# FEATURE_DELETE_EXISTING_USERS=false
# FEATURE_DELETE_EXISTING_ROLES=true
# FEATURE_DELETE_EXISTING_RBAC_USERS=true
# FEATURE_CREATE_RBAC_USERS=true
# FEATURE_DELETE_ALL_ENABLED=false
# FEATURE_FORCE_WIPE_WORKSPACE=false
#
# MAX_CONCURRENT_WORKSPACES=5
#
#
# EXAMPLE 3: Production with Proxy and HTTPS
# ============================================
# Best for: Enterprise deployments with strict security
#
# ADMIN_TOKEN=your-prod-rbac-token
# CONFIG_DIR=/etc/kwot/config/
# KONG_ADDR=https://api.kong.example.com:8444
# AUTH_METHOD=RBAC
# SSL_VERIFY=true
# CA=/etc/ssl/certs/company-ca.crt
# PROXY=http://proxy.company.com:8080
#
# FEATURE_DELETE_EXISTING_USERS=false
# FEATURE_DELETE_EXISTING_ROLES=true
# FEATURE_DELETE_EXISTING_RBAC_USERS=true
# FEATURE_CREATE_RBAC_USERS=true
# FEATURE_DELETE_ALL_ENABLED=false
# FEATURE_FORCE_WIPE_WORKSPACE=false
#
# MAX_CONCURRENT_WORKSPACES=15
#
#
# EXAMPLE 4: Development Mode (Safe - Read-Only)
# ===============================================
# Best for: Testing configuration changes safely
#
# ADMIN_TOKEN=your-dev-token
# CONFIG_DIR=./config/
# KONG_ADDR=http://localhost:8001
# AUTH_METHOD=RBAC
#
# FEATURE_DELETE_EXISTING_USERS=false
# FEATURE_DELETE_EXISTING_ROLES=false      # Don't delete roles
# FEATURE_DELETE_EXISTING_RBAC_USERS=false # Don't delete users
# FEATURE_CREATE_RBAC_USERS=false          # Don't create users
# FEATURE_DELETE_ALL_ENABLED=false         # Don't allow bulk delete
# FEATURE_FORCE_WIPE_WORKSPACE=false       # Don't force wipe
#
# MAX_CONCURRENT_WORKSPACES=5
#
# ============================================================================
