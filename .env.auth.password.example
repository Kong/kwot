# Kong Connection Settings
KONG_ADDR=http://localhost:8001

# Authentication method: RBAC | PASSWORD
AUTH_METHOD=PASSWORD

# PASSWORD Authentication (when AUTH_METHOD=PASSWORD)
# Admin user associated with the IDP user in Kong
ADMIN_USER=keycloak_user
# Base64 encoded IDP credentials (username:password)
BASE64_UID_PWD=c3R1K2tleWNsb2FrQGtvbmdocS5jb206cGFzc3dvcmQ=

# SSL/TLS Certificate Verification
# Set to false to skip certificate verification (development only, insecure!)
SSL_VERIFY=true

# Configuration directory
CONFIG_DIR=./config/

# Feature Flags
FEATURE_CREATE_RBAC_USERS=true
FEATURE_DELETE_EXISTING_RBAC_USERS=true
FEATURE_DELETE_EXISTING_USERS=false
FEATURE_DELETE_EXISTING_ROLES=true
FEATURE_FORCE_WIPE_WORKSPACE=false
FEATURE_DELETE_ALL_ENABLED=false

# Performance Settings
MAX_CONCURRENT_WORKSPACES=5

# Retry Configuration
# Number of retry attempts for resource availability checks (workspace, role, RBAC user creation)
# Uses exponential backoff: 50ms, 100ms, 150ms, 200ms, 250ms
MAX_RETRY_ATTEMPTS=5
